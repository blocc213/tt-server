# Copy to .env and replace this value with a long unique password.
# .env is excluded from Git and Docker build contexts.
TAURITAVERN_PASSWORD=replace-with-a-long-random-password

# By default the service is reachable only from the Ubuntu host. Keep this when
# Caddy/Nginx handles HTTPS, or set 0.0.0.0 to expose Docker's published port.
TAURITAVERN_BIND_ADDRESS=127.0.0.1
TAURITAVERN_PORT=8000

# Host directory containing all mutable TauriTavern data.
TAURITAVERN_DATA_DIR=./docker-data

RUST_LOG=info
