# Git metadata is not part of any build stage. The server binary embeds no
# revision string; only the Tauri desktop crate reads Git, and it is not in the
# `tauritavern-server` dependency graph.
.git

# Local dependencies and build outputs are rebuilt in their own image stages.
node_modules
.pnpm-store
src-tauri/target
fastools/target
target
release

# Mutable user data and secrets must never enter an image layer.
data
docker-data
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Local IDE/OS/test artifacts.
.DS_Store
.vscode
.idea
coverage
*.log
/tmp
